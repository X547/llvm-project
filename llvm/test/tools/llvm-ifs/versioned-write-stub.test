## Test writing a versioned stub ELF: .gnu.version_d, .gnu.version, and the
## new DT_VERDEF/DT_VERDEFNUM/DT_VERSYM dynamic entries.

# RUN: llvm-ifs --output-elf=%t.elf --target=x86_64-linux-gnu %s
# RUN: llvm-readobj -V --dynamic-table %t.elf | FileCheck %s

# CHECK:      VersionSymbols [
# CHECK-NEXT:   Symbol {
# CHECK-NEXT:     Version: 0
# CHECK-NEXT:     Name:
# CHECK-NEXT:   }
# CHECK-NEXT:   Symbol {
# CHECK-NEXT:     Version: 2
# CHECK-NEXT:     Name: foo@@V_1
# CHECK-NEXT:   }
# CHECK-NEXT:   Symbol {
# CHECK-NEXT:     Version: 3
# CHECK-NEXT:     Name: bar@V_2
# CHECK-NEXT:   }
# CHECK-NEXT:   Symbol {
# CHECK-NEXT:     Version: 1
# CHECK-NEXT:     Name: baz
# CHECK-NEXT:   }
# CHECK-NEXT: ]
# CHECK-NEXT: VersionDefinitions [
# CHECK-NEXT:   Definition {
# CHECK-NEXT:     Version: 1
# CHECK-NEXT:     Flags [ (0x1)
# CHECK-NEXT:       Base (0x1)
# CHECK-NEXT:     ]
# CHECK-NEXT:     Index: 1
# CHECK-NEXT:     Hash: {{[0-9]+}}
# CHECK-NEXT:     Name: libtest.so
# CHECK-NEXT:     Predecessors: []
# CHECK-NEXT:   }
# CHECK-NEXT:   Definition {
# CHECK-NEXT:     Version: 1
# CHECK-NEXT:     Flags [ (0x0)
# CHECK-NEXT:     ]
# CHECK-NEXT:     Index: 2
# CHECK-NEXT:     Hash: {{[0-9]+}}
# CHECK-NEXT:     Name: V_1
# CHECK-NEXT:     Predecessors: []
# CHECK-NEXT:   }
# CHECK-NEXT:   Definition {
# CHECK-NEXT:     Version: 1
# CHECK-NEXT:     Flags [ (0x0)
# CHECK-NEXT:     ]
# CHECK-NEXT:     Index: 3
# CHECK-NEXT:     Hash: {{[0-9]+}}
# CHECK-NEXT:     Name: V_2
# CHECK-NEXT:     Predecessors: [V_1]
# CHECK-NEXT:   }
# CHECK-NEXT: ]

# CHECK:      DynamicSection [
# CHECK-DAG:    0x000000006FFFFFF0 VERSYM
# CHECK-DAG:    0x000000006FFFFFFC VERDEF
# CHECK-DAG:    0x000000006FFFFFFD VERDEFNUM            3

--- !ifs-v1
IfsVersion: 3.0
SoName: libtest.so
Versions:
  - Name: V_1
  - Name: V_2
    Parents:
      - V_1
Symbols:
  - { Name: foo, Type: Func, Version: V_1 }
  - { Name: bar, Type: Func, Version: V_2, VersionHidden: true }
  - { Name: baz, Type: Func }
...
